# Renombra este archivo a .env y agrega tu token de Notion
# Para crear el token:
#   1. Ve a https://www.notion.so/my-integrations
#   2. Click "+ Nueva integración" → Tipo: Interna → Nombre: AMDA Dashboard
#   3. Copia el "Token interno de integración"
#   4. En cada BD de Notion (Pipeline Ventas, Planificador Publicaciones,
#      Gestión de cuentas, Q3 Shorts, Tareas):
#      click ··· → Conectar a integración → selecciona "AMDA Dashboard"

NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
